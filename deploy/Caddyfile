# Caddy يصدر شهادة HTTPS تلقائياً للنطاق ويجددها. لا سجل وصول افتراضياً (لا عناوين قرّاء على القرص).
{$ARCMS_DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 60MB
	}

	handle_path /media/* {
		root * /data/media
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options nosniff
		file_server
	}

	handle {
		reverse_proxy web:8000 {
			header_up X-Real-IP {remote_host}
		}
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}
}
