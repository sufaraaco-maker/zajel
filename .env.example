# ============================================================
#  إعدادات arcms على خادم المؤسسة. انسخ الملف إلى .env وعدّل القيم.
#  هذا الملف يحوي الأسرار: صلاحياته 600، ولا يُرفع إلى أي مستودع.
#  ولّد القيم السرية بالأمر:  docker compose run --rm web arcms_keys
# ============================================================

# --- الموقع ---
ARCMS_DOMAIN=news.example.org
ARCMS_SITE_URL=https://news.example.org
ARCMS_ALLOWED_HOSTS=news.example.org
ARCMS_CSRF_TRUSTED_ORIGINS=https://news.example.org
ARCMS_TIME_ZONE=Asia/Hebron
ARCMS_DEBUG=0

# --- الأسرار الأساسية (arcms_keys) ---
ARCMS_SECRET_KEY=
# مفتاح تشفير الحقول الحساسة (ملاحظات المصادر، أسرار التحقق الثنائي، رسائل القرّاء).
# لتدويره: ضع المفتاح الجديد أولاً ثم القديم بعد فاصلة، وأبقهما حتى تُحدَّث السجلات.
ARCMS_FIELD_KEY=

# --- قاعدة البيانات (docker compose يبني الرابط تلقائياً من كلمة المرور) ---
POSTGRES_PASSWORD=
# للتثبيت دون Docker:
# ARCMS_DATABASE_URL=postgres://arcms:PASSWORD@127.0.0.1:5432/arcms

# --- الأمان ---
ARCMS_2FA_ISSUER=Newsroom
ARCMS_SESSION_HOURS=12
ARCMS_LOGIN_MAX_FAILURES=5
ARCMS_LOGIN_LOCK_MINUTES=15
# حذف البلاغات المغلقة من صندوق المعلومات نهائياً بعد (أيام)
ARCMS_TIPS_RETENTION_DAYS=90
# نطاق مستقل لصندوق المعلومات (tips.example.org أو عنوان .onion) — انظر deploy/caddy-sites
# ARCMS_TIPS_HOST=
# عناوين الوكيل العكسي الموثوقة لترويسة X-Real-IP (افتراضياً: المحلي والشبكات الخاصة)
# ARCMS_TRUSTED_PROXIES=127.0.0.1/32,172.16.0.0/12

# --- البريد (النشرة اليومية وتأكيد الاشتراك) ---
ARCMS_SMTP_HOST=smtp.example.org
ARCMS_SMTP_PORT=587
ARCMS_SMTP_USER=
ARCMS_SMTP_PASSWORD=
ARCMS_SMTP_TLS=1
ARCMS_FROM_EMAIL=newsletter@news.example.org

# --- تيليجرام: رمز البوت من @BotFather (معرّفات القنوات تُضبط من غرفة التحرير) ---
ARCMS_TELEGRAM_BOT_TOKEN=

# --- واتساب: WhatsApp Business Cloud API من Meta ---
ARCMS_WHATSAPP_TOKEN=
ARCMS_WHATSAPP_PHONE_NUMBER_ID=
ARCMS_WHATSAPP_API_VERSION=v21.0

# --- صفحة فيسبوك: رمز وصول دائم للصفحة (Page Access Token) بصلاحية pages_manage_posts ---
ARCMS_FACEBOOK_PAGE_ID=
ARCMS_FACEBOOK_PAGE_TOKEN=
ARCMS_FACEBOOK_API_VERSION=v21.0

# --- إكس: تطبيق في developer.x.com بصلاحية القراءة والكتابة، ومفاتيح حساب المؤسسة ---
ARCMS_X_API_KEY=
ARCMS_X_API_SECRET=
ARCMS_X_ACCESS_TOKEN=
ARCMS_X_ACCESS_SECRET=

# --- إشعارات المتصفح (arcms_keys) ---
ARCMS_VAPID_PUBLIC_KEY=
ARCMS_VAPID_PRIVATE_KEY=
ARCMS_VAPID_SUBJECT=mailto:newsroom@news.example.org
# خدمات إشعارات إضافية مسموح بها فوق خدمات المتصفحات المعروفة (نادراً ما تلزم)
# ARCMS_PUSH_EXTRA_HOSTS=

# --- النسخ الاحتياطي المشفّر (arcms_backup_keygen) ---
# المفتاح العام فقط هنا. المفتاح الخاص يُحفظ خارج الخادم.
ARCMS_BACKUP_PUBLIC_KEY=
ARCMS_BACKUP_HOUR=3
ARCMS_BACKUP_KEEP=14
# نسخة خارج الخادم (موصى بها): أي تخزين متوافق مع S3. النسخ مشفّرة قبل الرفع.
# استخدم مفتاح وصول بلا صلاحية حذف، واضبط الاحتفاظ بقاعدة دورة حياة في الحاوية.
# ARCMS_OFFSITE_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# ARCMS_OFFSITE_BUCKET=newsroom-backups
# ARCMS_OFFSITE_REGION=eu-central-1
# ARCMS_OFFSITE_ACCESS_KEY=
# ARCMS_OFFSITE_SECRET_KEY=
# ARCMS_OFFSITE_PREFIX=arcms
# ARCMS_OFFSITE_KEEP=0   # صفر = لا يحذف الخادم أي نسخة بعيدة

# --- مفاتيح الأمان (WebAuthn) ---
# النطاق يُستنتج من ARCMS_SITE_URL. إن كانت غرفة التحرير على نطاق فرعي آخر فاضبطه (مثل example.org)
# وأضف أصل الغرفة: ARCMS_WEBAUTHN_ORIGINS=https://studio.example.org
# ARCMS_WEBAUTHN_RP_ID=
# ARCMS_WEBAUTHN_ORIGINS=

# --- مكتب الوكالات ---
# الخلاصات على عناوين عامة فقط؛ 1 إن كانت الوكالة تسلّم على شبكة داخلية.
ARCMS_WIRE_ALLOW_PRIVATE=0
ARCMS_WIRE_RETENTION_DAYS=14

# --- الأداء والقياس ---
# عملية لكل نواة معالج (ولكل عملية 4 خيوط). انظر docs/LOADTEST.md
ARCMS_WEB_WORKERS=3
ARCMS_ANALYTICS_RAW_DAYS=35
# Redis يعمل مع docker compose تلقائياً. دون Docker: ثبّته وضع عنوانه هنا (وإلا فجدول في القاعدة، أبطأ).
# ARCMS_CACHE_URL=redis://127.0.0.1:6379/0
ARCMS_LOG_LEVEL=INFO
